# --- Linux API (copy to /etc/fam-pic-vault.env or export before npm start) ---
PORT=3000
UPLOAD_DIR=/var/lib/fam-pic-vault/uploads
# Public URL where browsers reach THIS API (needed so image URLs work from Vercel)
PUBLIC_BASE_URL=https://pics.yourdomain.com
# Your Vercel site origin(s), comma-separated
CORS_ORIGIN=https://your-app.vercel.app
# Don't serve the static site from Linux when Vercel hosts it
SERVE_FRONTEND=0

# --- Vercel project environment ---
# API_URL=https://pics.yourdomain.com
