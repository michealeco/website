[Unit]
Description=Eco Fam Vault API (Linux photo storage)
After=network.target

[Service]
Type=simple
User=micheal
WorkingDirectory=/opt/fam-pic-vault
Environment=PORT=3000
Environment=UPLOAD_DIR=/home/micheal/fam-pic-uploads
Environment=PUBLIC_BASE_URL=https://smirk-keep-undone.ngrok-free.dev
Environment=CORS_ORIGIN=*
Environment=SERVE_FRONTEND=0
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
