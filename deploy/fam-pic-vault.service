[Unit]
Description=Fam Pic Vault API (Linux storage)
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/fam-pic-vault
Environment=PORT=3000
Environment=UPLOAD_DIR=/var/lib/fam-pic-vault/uploads
Environment=PUBLIC_BASE_URL=https://pics.yourdomain.com
Environment=CORS_ORIGIN=https://your-app.vercel.app
Environment=SERVE_FRONTEND=0
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
